{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Book Técnico",
  "version": "0.1.0",
  "identifier": "com.inventcloud.booktecnico",
  "build": {
    "frontendDist": "../launcher"
  },
  "app": {
    "windows": [
      {
        "title": "Book Técnico",
        "width": 1360,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "userAgent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/130.0.0.0 Safari/537.36 Edg/130.0.0.0 BookTecnicoDesktop/0.1.0"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "inventCloud",
    "shortDescription": "Book Técnico",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
