# ═══ Variáveis do docker compose — copie para .env e ajuste ═══
#   cp .env.example .env
# O .env fica fora do git (.gitignore). Mudar usuário/senha do Mongo depois da 1ª subida
# NÃO altera o usuário já criado no volume: para recomeçar, "docker compose down -v" (apaga os dados!).

# Porta do app na máquina
BOOK_PORT=5173

# Banco usado pelo app: mongo | sqlite (vazio = escolher na tela de Configurações)
BOOK_STORAGE=mongo

# MongoDB (criado automaticamente na primeira subida)
MONGO_VERSION=7
MONGO_USER=booktecnico
MONGO_PASSWORD=troque-esta-senha
MONGO_DB=book_tecnico
# MONGO_EXPOSE_PORT=27017

# Fuso horário (agendamento do backup, datas dos logs)
TZ=America/Sao_Paulo

# Books automáticos (🤖 no cliente): pasta da máquina onde os arquivos gerados são salvos.
# Pode ser um compartilhamento de rede já montado/mapeado nesta máquina. Padrão: ./books-gerados
# BOOK_EXPORT_DIR=D:\Books
# Navegador do book automático dentro da imagem (~900 MB). false = imagem menor, sem book automático.
# BOOK_AUTOMATION=false
